{
  "name": "carbon-credit-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Hợp đồng thông minh cho hệ thống quản lý tín chỉ carbon (ERC-721 lô tín chỉ, pool ERC-20, hủy tín chỉ)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas": "cross-env REPORT_GAS=true hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "demo:local": "hardhat run scripts/demo.js",
    "export": "node scripts/export-abi.js",
    "e2e": "hardhat run scripts/e2e-indexer.js"
  },
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "hardhat": "^2.29.1"
  }
}
