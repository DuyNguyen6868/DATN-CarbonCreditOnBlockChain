\setlength{\cftbeforesubsecskip}{4pt}
\renewcommand{\cftfigpresnum}{Hình }
\setlength{\cftfigindent}{0pt}
\setlength{\cftfignumwidth}{2cm}
\setlength{\cftbeforefigskip}{4pt}
\renewcommand{\cfttabpresnum}{Bảng }
\setlength{\cfttabindent}{0pt}
\setlength{\cfttabnumwidth}{2cm}
\setlength{\cftbeforetabskip}{4pt}

% ================= CHÚ THÍCH HÌNH / BẢNG =================
% Theo mẫu SoICT: \usepackage[font=small,labelfont=bf]{caption}, nhãn "Hình 1.1:" in đậm,
% chú thích bảng ở trên bảng, chú thích hình ở dưới hình. Chú thích không có dấu chấm cuối.
\captionsetup{
    font={small,singlespacing},
    labelfont=bf,
    labelsep=colon,
    skip=6pt
}
\captionsetup[figure]{position=bottom, belowskip=4pt}
\captionsetup[table]{position=top}
\captionsetup[sub]{font=small, labelfont=bf}

% ================= PHƯƠNG TRÌNH: "PT 1.1" =================
\numberwithin{equation}{chapter}
\renewcommand{\tagform@}[1]{\maketag@@@{\ignorespaces PT #1\unskip\@@italiccorr}}

% ================= TÀI LIỆU THAM KHẢO =================
% Giãn dòng đơn trong từng mục, cách nhau 4 pt; số thứ tự [1] thẳng hàng với lề trái.
\AtBeginEnvironment{thebibliography}{\setstretch{1}\fontsize{12}{14}\selectfont}
% \bstctlcite (lấy từ lớp IEEEtran): gửi mục điều khiển @IEEEtranBSTCTL cho IEEEtran-hust.bst.
% main.tex dùng \bstctlcite{BSTcontrol} để tắt việc thay tên tác giả lặp lại bằng dấu "——".
\def\bstctlcite{\@ifnextchar[{\@bstctlcite}{\@bstctlcite[@auxout]}}
\def\@bstctlcite[#1]#2{\@bsphack
    \@for\@citeb:=#2\do{%
        \edef\@citeb{\expandafter\@firstofone\@citeb}%
        \if@filesw\immediate\write\csname #1\endcsname{\string\citation{\@citeb}}\fi}%
    \@esphack}
\patchcmd{\thebibliography}{\sloppy}{\sloppy\setlength{\itemsep}{4pt}\setlength{\parsep}{0pt}}{}{}

% ================= MÃ NGUỒN =================
\lstdefinelanguage{Solidity}{
    morekeywords={pragma,solidity,contract,interface,library,is,function,modifier,event,emit,
        struct,enum,mapping,public,private,internal,external,view,pure,payable,returns,return,
        memory,storage,calldata,constructor,override,virtual,require,revert,if,else,for,while,
        new,delete,import,using,address,bool,string,bytes,bytes32,uint,uint8,uint256,int,int256},
    sensitive=true, morecomment=[l]{//}, morecomment=[s]{/*}{*/}, morestring=[b]",
}
\lstset{
    basicstyle=\ttfamily\footnotesize\singlespacing, keywordstyle=\bfseries,
    commentstyle=\itshape\color{gray}, numbers=left, numberstyle=\tiny, frame=single,
    breaklines=true, columns=fullflexible, keepspaces=true, showstringspaces=false, tabsize=4
}
\AtBeginDocument{\renewcommand{\lstlistingname}{Đoạn mã}}

