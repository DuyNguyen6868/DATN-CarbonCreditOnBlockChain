% ================= TIỆN ÍCH =================
% Ghi chủ thể tạo và ngày tạo của hình vẽ do công cụ AI tạo, đặt cuối chú thích dài (không vào
% danh mục hình). \hinhtao[Claude]{20/10/2026} -> "(Created by: Claude, 20/10/2026)".
\newcommand{\hinhtao}[2][Claude]{(Created by: #1, #2)}

% Khối chữ ký: "Hà Nội, ngày … tháng … năm …"
\newcommand{\khoichuky}[1]{%
    \par\vspace{12pt}\hfill
    \begin{minipage}{7cm}
        \centering\singlespacing
        \textit{Hà Nội, ngày …. tháng …. năm ….}\\
        \textbf{#1}\\
        \textit{Ký và ghi rõ họ tên}
    \end{minipage}\par
}

% Chèn trang scan (PDF) nếu đã có file, nếu chưa có thì in trang tiêu đề giữ chỗ.
\newcommand{\chentrangscan}[3]{%
    \IfFileExists{#1}{\includepdf[pages=-]{#1}}{\chapter*{#2}\textit{#3}\clearpage}%
}

% Đánh dấu chỗ còn phải tự viết (chữ đỏ). Trước khi nộp, tìm "\canviet" để chắc chắn không còn.
\newcommand{\canviet}[1]{\textcolor{red}{[\textit{#1}]}}

